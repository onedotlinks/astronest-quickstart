# Copy to .env.local and fill in. Never commit .env.local.

# Required. Create a key at https://www.astronest.ai/developer
# Sandbox keys are free with no time limit and return fixed sample responses. Every account also gets 100 free
# live credits ONCE, valid for 60 days from its first live key (they do not renew).
ASTRONEST_API_KEY=

# Optional. Defaults to production.
# ASTRONEST_BASE_URL=https://www.astronest.ai/api/developer

# The API routes in this app spend YOUR credits for whoever calls them. They answer only on
# localhost unless you set this. Put your own sign-in in front before you set it on a public deploy.
# ALLOW_PUBLIC_DEMO=true

# Optional: "Explain in plain words" with your own model, through any OpenAI-compatible
# chat-completions endpoint (OpenAI, Vercel AI Gateway, OpenRouter, a local Ollama, ...).
# Leave LLM_API_KEY empty to hide the button. No AstroNest credits are spent on this step.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
